# 로컬 개발용 기본값. 복사해서 .env로 쓰고 필요하면 값을 바꾼다 (.env는 커밋하지 않는다).
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432

# 답변 생성 (Claude API). 키는 .env에만 넣는다
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# 질문 API의 사용자 확인 방식: disabled(기본, API 막힘) | dev_header(X-User-Id 헤더, 개발 전용)
#                              | oidc(회사 로그인 시스템의 토큰, 운영용)
# AUTH_MODE=dev_header
# OIDC_ISSUER=https://login.microsoftonline.com/<테넌트 ID>/v2.0
# OIDC_AUDIENCE=<이 앱의 ID>
# OIDC_LOGIN_CLAIM=email

# 감사 기록: 질문·답변 원문 저장(false면 길이와 해시만), 보관 기간(일, 비우면 지우지 않음)
# AUDIT_STORE_TEXT=true
# AUDIT_RETENTION_DAYS=365
# LOG_LEVEL=INFO
# LLM 요청 원문을 DEBUG 로그로 (개발 전용, AUTH_MODE=oidc와 함께 쓸 수 없음, LOG_LEVEL=DEBUG 필요)
# LOG_PROMPTS=false