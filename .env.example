# 로컬 개발용 기본값. 복사해서 .env로 쓰고 필요하면 값을 바꾼다 (.env는 커밋하지 않는다).
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432

# 답변 생성 (Claude API). 키는 .env에만 넣는다
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# 질문 API의 사용자 확인 방식: disabled(기본, API 막힘) | dev_header(X-User-Id 헤더, 개발 전용)
# AUTH_MODE=dev_header
