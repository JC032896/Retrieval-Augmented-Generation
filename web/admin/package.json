{
  "name": "rag-admin",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "사내 문서 질의(RAG) 관리 화면",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "gen:api": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "lucide-react": "^1.72.0",
    "oidc-client-ts": "^3.5.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
