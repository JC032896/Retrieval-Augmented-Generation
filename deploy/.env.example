# 설치형 배포 설정 (선택). 없어도 docker compose up -d로 데모 상태까지 뜬다.
# 바꿀 값이 있을 때만 복사해서 deploy/.env로 쓴다 (.env는 커밋하지 않는다)
#   cp .env.example .env

# 비밀번호: 비워 두면 첫 실행 때 setup이 무작위로 만들어 비밀 볼륨에 저장한다 (권장).
# 직접 정하려면 첫 실행 전에 채운다. 이미 만들어진 뒤에 바꾸면 반영되지 않는다 (deploy/README.md "비밀번호")
DB_OWNER_USER=rag_owner
DB_OWNER_PASSWORD=
DB_NAME=rag
# 앱 계정 (rag_app 역할: 감사 기록은 쓰기만), 감사 담당 계정 (rag_auditor 역할: 감사 기록 읽기만)
APP_DB_USER=rag_service
APP_DB_PASSWORD=
AUDIT_DB_USER=rag_audit_ops
AUDIT_DB_PASSWORD=
# 데모 Keycloak(compose.override.yaml) 관리자 비밀번호
KEYCLOAK_ADMIN_PASSWORD=

# 수집할 문서 폴더 (org.yaml, acl.yaml, docs/). 기본은 저장소의 샘플
CORPUS_DIR=../samples
APP_PORT=8000
# 앞단 리버스 프록시의 주소 (감사 기록에 실제 사용자 IP를 남기려면)
FORWARDED_ALLOW_IPS=127.0.0.1
# 1이면 모델을 내려받지 않고 모델 볼륨에 있는지만 확인한다 (폐쇄망 설치)
OFFLINE_INSTALL=0
# 앱 이미지. 비우면 이 코드 버전의 공개 이미지(ghcr.io/jc032896/rag-service:<버전>). 사내 레지스트리에 옮겨 둔 이미지를 쓸 때만
# APP_IMAGE=registry.example.co.kr/rag-service:0.1.0

# 답변 LLM. 기본은 Claude API (키를 비우면 질문 API가 503)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# 사내 LLM(OpenAI 호환 API: vLLM, Ollama 등)을 쓸 때. 문서 조각이 회사 밖으로 나가지 않는다
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=http://gpu-server:8000/v1      (함께 띄우는 Ollama: http://ollama:11434/v1)
#   LLM_MODEL=<그 서버의 모델 이름>
#   LLM_API_KEY=<서버가 키를 요구할 때만>
LLM_BASE_URL=
LLM_API_KEY=

# 회사 로그인 (OIDC). compose.override.yaml(데모 Keycloak)을 지운 뒤에 쓴다. Microsoft 365 예:
#   OIDC_ISSUER=https://login.microsoftonline.com/<테넌트 ID>/v2.0
#   OIDC_AUDIENCE=<로그인 시스템에 등록한 이 앱의 ID>
#   OIDC_LOGIN_CLAIM=email
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_LOGIN_CLAIM=email
OIDC_ALLOW_HTTP_HOSTS=
# 관리 화면 역할. 토큰에서 그룹 목록이 담긴 값의 이름과, 역할마다 대응하는 그룹 이름(또는 Entra ID 그룹 객체 ID).
# 역할은 서로 포함하지 않는다: 중앙 관리자라도 감사 담당 그룹에 없으면 감사 기록을 볼 수 없다
OIDC_GROUPS_CLAIM=groups
ADMIN_GROUP=rag-admin
DOC_MANAGER_GROUP=rag-doc-manager
AUDITOR_GROUP=rag-auditor

# 감사 기록과 사용 한도 (README "감사 기록", "LLM 사용 한도")
AUDIT_STORE_TEXT=true
# 관리 화면에서 감사 담당자가 감사 기록을 본다. 앱이 감사 담당 DB 계정을 쓰게 되므로, 앱이 뚫려도
# 감사 기록이 새지 않게 하려면 false (감사 조사는 scripts/replay.py 등 별도 도구로)
ADMIN_AUDIT_VIEW=true
AUDIT_RETENTION_DAYS=
LLM_DAILY_REQUESTS_PER_USER=200
LLM_DAILY_BUDGET_USD=20
LLM_CONCURRENT_PER_USER=3
LOG_LEVEL=INFO
