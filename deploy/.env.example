# 설치형 배포 설정. 복사해서 deploy/.env로 쓰고 비밀번호와 키를 채운다 (.env는 커밋하지 않는다)
#   cp .env.example .env
# 비밀번호는 길고 서로 다르게 정한다. 예: python -c "import secrets; print(secrets.token_urlsafe(24))"

# DB 소유자 계정: 마이그레이션, 보관 기간 삭제에만 쓴다. 앱 컨테이너에는 넘기지 않는다
DB_OWNER_USER=rag_owner
DB_OWNER_PASSWORD=
DB_NAME=rag
# 앱 계정 (rag_app 역할: 감사 기록은 쓰기만), 감사 담당 계정 (rag_auditor 역할: 감사 기록 읽기만, 선택)
APP_DB_USER=rag_service
APP_DB_PASSWORD=
AUDIT_DB_USER=rag_audit_ops
AUDIT_DB_PASSWORD=

# 수집할 문서 폴더 (org.yaml, acl.yaml, docs/). 기본은 저장소의 샘플
CORPUS_DIR=../samples
APP_PORT=8000
# 앞단 리버스 프록시의 주소 (감사 기록에 실제 사용자 IP를 남기려면)
FORWARDED_ALLOW_IPS=127.0.0.1

# 답변 생성 (Claude API). 비우면 질문 API가 503
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# 회사 로그인 (OIDC). Microsoft 365 예:
#   OIDC_ISSUER=https://login.microsoftonline.com/<테넌트 ID>/v2.0
#   OIDC_AUDIENCE=<로그인 시스템에 등록한 이 앱의 ID>
#   OIDC_LOGIN_CLAIM=email
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_LOGIN_CLAIM=email
OIDC_ALLOW_HTTP_HOSTS=

# 함께 띄우는 데모 Keycloak을 쓸 때 (docker compose --profile keycloak up -d)
#   OIDC_ISSUER=http://keycloak:8080/realms/hanbit
#   OIDC_AUDIENCE=rag-service
#   OIDC_LOGIN_CLAIM=preferred_username
#   OIDC_ALLOW_HTTP_HOSTS=keycloak
KEYCLOAK_ADMIN_PASSWORD=

# 감사 기록과 사용 한도 (README "감사 기록", "LLM 사용 한도")
AUDIT_STORE_TEXT=true
AUDIT_RETENTION_DAYS=
LLM_DAILY_REQUESTS_PER_USER=200
LLM_DAILY_BUDGET_USD=20
LLM_CONCURRENT_PER_USER=3
LOG_LEVEL=INFO
